---
import { Icon } from "astro-icon/components";
import ProjectCard from "@/components/pages/projects/ProjectCard.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import { getSortedProjects } from "@/utils/content-utils";
import {
	getProjectStatusMeta,
	PROJECT_STATUS_KEYS,
} from "@/utils/projects-utils";
import { getFileDirFromPath, removeFileExtension } from "@/utils/url-utils";
import "@/styles/pages/card-grid.css";


const title = i18n(I18nKey.projects);
const description = i18n(I18nKey.projectsDescription);

const projects = await getSortedProjects();
const projectMeta = projects.map((p) => ({
	id: removeFileExtension(p.id),
	title: p.data.title,
	description: p.data.description,
	image: p.data.image,
	basePath: getFileDirFromPath(p.filePath || ""),
	tags: p.data.tags,
	published: p.data.published,
	link: p.data.link,
	status: p.data.status,
}));

// 筛选：显示全部已知状态（带图标）
const statusFilters = PROJECT_STATUS_KEYS.map((key) => {
	const meta = getProjectStatusMeta(key);
	return { key, label: meta.label, icon: meta.icon };
});
---

<MainGridLayout title={title} description={description}>
	<section class="page-shell">
		<!-- 标题面板 -->
		<header class="card-base page-header">
			<div class="page-heading">
				<div class="page-icon" aria-hidden="true">
					<Icon name="material-symbols:rocket-launch" />
				</div>
				<div>
					<h2>{title}</h2>
					{description && <p>{description}</p>}
				</div>
			</div>
			<div class="page-count" aria-label={title}>
				<Icon name="material-symbols:rocket-launch" />
				<strong>{projectMeta.length}</strong>
				<span>{title}</span>
			</div>
		<!-- 搜索 + 状态筛选（标题面板内，整行；搜索与筛选分两行） -->
		<project-filter style="grid-column: 1 / -1">
			<div class="relative mb-3">
				<Icon
					name="material-symbols:search"
					class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-500 text-lg pointer-events-none"
				/>
				<input
					type="text"
					data-search
					placeholder={i18n(I18nKey.projectSearch)}
					class="w-full pl-10 pr-4 py-2 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
				/>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<button
					data-status="all"
					class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
					data-active
				>
					{i18n(I18nKey.all)}
				</button>
				{statusFilters.map((s) => (
					<button
						data-status={s.key}
						class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200 inline-flex items-center gap-1.5"
					>
						{s.icon && <Icon name={s.icon} class="text-base" />}
						{s.label}
					</button>
				))}
			</div>
		</project-filter>
		</header>

		<!-- 内容面板：项目卡片网格 -->
		{projectMeta.length > 0 ? (
			<div class="card-grid" style="--card-grid-min-width: 320px">
				{projectMeta.map((p) => (
					<ProjectCard
						id={p.id}
						title={p.title}
						description={p.description}
						image={p.image}
						basePath={p.basePath}
						tags={p.tags}
						published={p.published}
						link={p.link}
						status={p.status}
					/>
				))}
			</div>
		) : (
			<div class="card-base flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500">
				<Icon name="material-symbols:rocket-launch" class="text-6xl mb-4 opacity-50" />
				<p class="text-lg">{i18n(I18nKey.projectEmpty)}</p>
			</div>
		)}

		<!-- 筛选无结果空态 -->
		<div class="projects-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
			<Icon name="material-symbols:search-off-rounded" class="text-4xl mb-3" />
			<div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
		</div>
	</section>

	<div id="manage-bar" class="card-base px-4 py-3 flex flex-wrap items-center gap-2 mb-4 hidden">
		<span class="text-sm font-medium">管理</span>
		<span id="manage-hint" class="text-xs text-neutral-500"></span>
		<div class="grow"></div>
		<a id="manage-new" class="px-3 py-1.5 rounded-full bg-(--primary) text-white text-sm font-medium">+ 新建项目</a>
		<button id="manage-login" class="px-3 py-1.5 rounded-full border border-(--line-divider) text-sm">登录</button>
	</div>

	<script is:inline>
		(function () {
			var CLOUD = "https://tomori-admin.altria358.workers.dev";
			var OWNER = "Altria358";
			var REPO = "Tomori";
			var BRANCH = "main";
			var DIR = "src/content/projects";

			var base = location.pathname.replace(/projects\/?$/, "");
			var session = localStorage.getItem("admin_session") || "";
			var pat = localStorage.getItem("gh_pat") || "";

			var bar = document.getElementById("manage-bar");
			var hint = document.getElementById("manage-hint");
			var newBtn = document.getElementById("manage-new");
			var loginBtn = document.getElementById("manage-login");
			if (!bar) return;

			var loggedIn = !!(session || pat);
			bar.classList.remove("hidden");
			if (!loggedIn) {
				newBtn.classList.add("hidden");
				hint.textContent = "登录后可以在卡片上直接编辑、删除";
				loginBtn.onclick = function () {
					location.href = base + "admin/";
				};
			} else {
				loginBtn.classList.add("hidden");
				hint.textContent = "卡片右上角有「编辑 / 删除」";
				newBtn.setAttribute("href", base + "admin/?new=projects");
			}

			function toast(msg, bad) {
				var el = document.createElement("div");
				el.textContent = msg;
				el.style.cssText =
					"position:fixed;left:50%;bottom:28px;transform:translateX(-50%);z-index:9999;padding:10px 18px;border-radius:12px;font-size:14px;color:#fff;background:" +
					(bad ? "#dc2626" : "#0f766e") +
					";box-shadow:0 8px 24px rgba(0,0,0,.18)";
				document.body.appendChild(el);
				setTimeout(function () {
					el.remove();
				}, 2600);
			}

			async function cloudApi(path, opts) {
				opts = opts || {};
				var ctrl = new AbortController();
				var timer = setTimeout(function () {
					ctrl.abort();
				}, 12000);
				var res;
				try {
					res = await fetch(CLOUD + path, {
						method: opts.method || "GET",
						headers: Object.assign(
							{ "content-type": "application/json" },
							session ? { authorization: "Bearer " + session } : {},
						),
						body: opts.body ? JSON.stringify(opts.body) : undefined,
						signal: ctrl.signal,
					});
				} finally {
					clearTimeout(timer);
				}
				var data = null;
				try {
					data = await res.json();
				} catch (e) {}
				if (!res.ok) throw new Error((data && data.error) || res.status + "");
				return data;
			}

			async function ghApi(path, opts) {
				opts = opts || {};
				var res = await fetch("https://api.github.com/repos/" + OWNER + "/" + REPO + path, {
					method: opts.method || "GET",
					headers: {
						accept: "application/vnd.github+json",
						authorization: "Bearer " + pat,
						"content-type": "application/json",
					},
					body: opts.body ? JSON.stringify(opts.body) : undefined,
				});
				if (!res.ok) throw new Error(res.status + " " + res.statusText);
				return res.status === 204 ? null : res.json();
			}

			async function removeProject(slug) {
				var path = DIR + "/" + slug + ".md";
				if (session) {
					var d = await cloudApi("/api/file?path=" + encodeURIComponent(path) + "&_=" + Date.now());
					await cloudApi("/api/file", { method: "DELETE", body: { path: path, sha: d.sha } });
					return;
				}
				var cur = await ghApi("/contents/" + path + "?ref=" + BRANCH);
				await ghApi("/contents/" + path, {
					method: "DELETE",
					body: { message: "删除项目：" + slug, sha: cur.sha, branch: BRANCH },
				});
			}

			function decorate() {
				document.querySelectorAll(".project-card").forEach(function (card) {
					if (card.querySelector(".manage-tools")) return;
					var link = card.querySelector('a[href*="/projects/"]');
					if (!link) return;
					var href = link.getAttribute("href") || "";
					var parts = href.replace(/\/$/, "").split("/");
					var slug = parts[parts.length - 1];
					if (!slug) return;

					var tools = document.createElement("div");
					tools.className = "manage-tools";
					tools.style.cssText = "position:absolute;top:10px;right:10px;z-index:30;display:flex;gap:6px";

					if (loggedIn) {
						var edit = document.createElement("a");
						edit.href = base + "admin/?tab=projects&edit=" + encodeURIComponent(slug);
						edit.textContent = "编辑";
						edit.style.cssText =
							"padding:4px 10px;border-radius:999px;font-size:12px;background:rgba(255,255,255,.92);color:#0f172a;border:1px solid rgba(0,0,0,.08)";

						var del = document.createElement("button");
						del.textContent = "删除";
						del.style.cssText =
							"padding:4px 10px;border-radius:999px;font-size:12px;background:#dc2626;color:#fff;border:none";
						del.onclick = function (e) {
							e.preventDefault();
							e.stopPropagation();
							if (!confirm("确定删除项目「" + slug + "」？")) return;
							del.disabled = true;
							del.textContent = "删除中";
							removeProject(slug)
								.then(function () {
									card.remove();
									toast("已删除，1~2 分钟后线上生效");
								})
								.catch(function (err) {
									del.disabled = false;
									del.textContent = "删除";
									toast("删除失败：" + err.message, true);
								});
						};
						tools.appendChild(edit);
						tools.appendChild(del);
					} else {
						var link2 = document.createElement("a");
						link2.href = base + "admin/?tab=projects&edit=" + encodeURIComponent(slug);
						link2.textContent = "管理";
						link2.style.cssText =
							"padding:4px 10px;border-radius:999px;font-size:12px;background:rgba(255,255,255,.92);color:#0f172a;border:1px solid rgba(0,0,0,.08)";
						tools.appendChild(link2);
					}

					card.style.position = "relative";
					card.appendChild(tools);
				});
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", decorate);
			} else {
				decorate();
			}
			setTimeout(decorate, 400);
		})();
	</script>

	<script slot="head" is:inline>
		if (!customElements.get("project-filter")) {
			class ProjectFilter extends HTMLElement {
				selectedStatus = "all";
				connectedCallback() {
					this.addEventListener("click", this.handleClick);
					this.addEventListener("input", this.handleInput);
				}
				disconnectedCallback() {
					this.removeEventListener("click", this.handleClick);
					this.removeEventListener("input", this.handleInput);
				}
				handleClick(e) {
					const button = e.target.closest("button");
					if (!button) return;
					this.selectedStatus = button.dataset.status;
					this.querySelectorAll("button").forEach((b) =>
						b.removeAttribute("data-active"),
					);
					button.setAttribute("data-active", "");
					this.applyFilters();
				}
				handleInput() {
					this.applyFilters();
				}
				applyFilters() {
					const container = this.closest(".page-shell");
					if (!container) return;
					const input = this.querySelector("[data-search]");
					const query = (input?.value || "").toLowerCase().trim();
					const cards = container.querySelectorAll(".project-card");
					let hasVisible = false;
					cards.forEach((card) => {
						const statusMatch =
							this.selectedStatus === "all" ||
							card.dataset.status === this.selectedStatus;
						const tags = (card.dataset.tags || "").toLowerCase();
						const title = (
							card.querySelector(".post-card-title")?.textContent || ""
						).toLowerCase();
						const desc = (
							card.querySelector(".description")?.textContent || ""
						).toLowerCase();
						const searchMatch =
							!query ||
							title.includes(query) ||
							desc.includes(query) ||
							tags.includes(query);
						if (statusMatch && searchMatch) {
							card.style.display = "";
							hasVisible = true;
						} else {
							card.style.display = "none";
						}
					});
					const empty = container.querySelector(".projects-empty");
					if (empty) {
						empty.classList.toggle("hidden", hasVisible);
						empty.classList.toggle("flex", !hasVisible);
					}
				}
			}
			customElements.define("project-filter", ProjectFilter);
		}
	</script>

</MainGridLayout>
