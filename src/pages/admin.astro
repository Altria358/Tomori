---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";

const title = "管理";
const description = "登录后添加、修改、删除文章和项目";
---

<MainGridLayout title={title} description={description}>
  <div class="card-base px-6 py-6 w-full">
    <div class="page-heading mb-4">
      <div>
        <h2>内容管理</h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          输入密码就能新增 / 修改 / 删除文章和项目，保存后 1~2 分钟自动发布。
        </p>
      </div>
    </div>

    <!-- 登录 -->
    <div id="setup" class="rounded-xl border border-(--line-divider) p-4">
      <div class="font-bold mb-2">登录</div>
      <div class="flex flex-wrap gap-2">
        <input
          id="pwdInput"
          type="password"
          placeholder="管理密码"
          class="grow min-w-50 px-3 py-2 rounded-xl border border-(--line-divider) bg-transparent text-sm outline-none focus:border-(--primary)"
        />
        <button
          id="loginBtn"
          class="px-4 py-2 rounded-xl bg-(--primary) text-white text-sm font-medium hover:opacity-90"
        >
          进入
        </button>
      </div>
      <p id="setupMsg" class="text-sm mt-2 text-neutral-500"></p>
      <details class="mt-3 text-xs text-neutral-400">
        <summary class="cursor-pointer">高级：后台地址</summary>
        <div class="flex flex-wrap gap-2 mt-2">
          <input
            id="backendInput"
            class="grow min-w-50 px-2 py-1 rounded-lg border border-(--line-divider) bg-transparent outline-none focus:border-(--primary)"
          />
          <button id="backendSave" class="px-3 py-1 rounded-lg border border-(--line-divider)">保存</button>
        </div>
        <p class="mt-1">留空即用默认地址；本地调试填 http://127.0.0.1:8901</p>
      </details>
    </div>

    <!-- 管理 -->
    <div id="panel" class="hidden mt-5">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <button data-tab="posts" class="tab-btn px-4 py-1.5 rounded-full text-sm font-medium">文章</button>
        <button data-tab="projects" class="tab-btn px-4 py-1.5 rounded-full text-sm font-medium">项目</button>
        <div class="grow"></div>
        <button id="newBtn" class="px-4 py-1.5 rounded-full bg-(--primary) text-white text-sm font-medium">
          + 新建
        </button>
        <button id="logoutBtn" class="px-3 py-1.5 rounded-full border border-(--line-divider) text-sm">
          退出
        </button>
      </div>

      <div id="list" class="space-y-2"></div>

      <div id="editor" class="hidden mt-5 rounded-xl border border-(--line-divider) p-4">
        <div id="editorTitle" class="font-bold mb-3">新建</div>
        <div class="grid sm:grid-cols-2 gap-3 text-sm">
          <label class="flex flex-col gap-1">
            <span>文件名（英文/数字/短横线，不带 .md）</span>
            <input id="fName" class="px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent outline-none focus:border-(--primary)" placeholder="my-new-post" />
          </label>
          <label class="flex flex-col gap-1">
            <span>标题</span>
            <input id="fTitle" class="px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent outline-none focus:border-(--primary)" />
          </label>
          <label class="flex flex-col gap-1">
            <span>日期（YYYY-MM-DD）</span>
            <input id="fDate" type="date" class="px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent outline-none focus:border-(--primary)" />
          </label>
          <label class="flex flex-col gap-1">
            <span>标签（逗号分隔）</span>
            <input id="fTags" class="px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent outline-none focus:border-(--primary)" placeholder="随笔, MyGO" />
          </label>
          <label class="flex flex-col gap-1" id="catWrap">
            <span>分类</span>
            <input id="fCat" class="px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent outline-none focus:border-(--primary)" placeholder="随笔" />
          </label>
          <label class="flex flex-col gap-1 hidden" id="statusWrap">
            <span>状态</span>
            <select id="fStatus" class="px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent outline-none focus:border-(--primary)">
              <option value="planning">计划中</option>
              <option value="developing">开发中</option>
              <option value="published">已发布</option>
              <option value="archived">已归档</option>
            </select>
          </label>
          <label class="flex flex-col gap-1 sm:col-span-2">
            <span>简介（列表页显示）</span>
            <input id="fDesc" class="px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent outline-none focus:border-(--primary)" />
          </label>
          <label class="flex flex-col gap-1 sm:col-span-2 hidden" id="linkWrap">
            <span>链接（可留空，格式：显示名|https://...）</span>
            <input id="fLink" class="px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent outline-none focus:border-(--primary)" placeholder="源码|https://github.com/..." />
          </label>
          <label class="flex flex-col gap-1 sm:col-span-2">
            <span>正文（Markdown）</span>
            <textarea id="fBody" rows="14" class="px-3 py-2 rounded-lg border border-(--line-divider) bg-transparent outline-none focus:border-(--primary) font-mono text-[13px]"></textarea>
          </label>
        </div>
        <div class="flex items-center gap-2 mt-3">
          <button id="saveBtn" class="px-4 py-2 rounded-xl bg-(--primary) text-white text-sm font-medium">保存</button>
          <button id="cancelBtn" class="px-4 py-2 rounded-xl border border-(--line-divider) text-sm">取消</button>
          <span id="editorMsg" class="text-sm text-neutral-500"></span>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const DEFAULT_BACKEND = "https://tomori-admin.altria358.workers.dev";
    const DIRS = { posts: "src/content/posts", projects: "src/content/projects" };
    const $ = (id) => document.getElementById(id);

    function backend() {
      const saved = (localStorage.getItem("admin_backend") || "").trim();
      const base = saved || (location.hostname === "localhost" || location.hostname === "127.0.0.1" ? "http://127.0.0.1:8901" : DEFAULT_BACKEND);
      return base.replace(/\/+$/, "");
    }

    let session = localStorage.getItem("admin_session") || "";
    let tab = "posts";
    let editing = null;

    async function api(path, opts) {
      opts = opts || {};
      const res = await fetch(backend() + path, {
        method: opts.method || "GET",
        headers: Object.assign(
          { "content-type": "application/json" },
          session ? { authorization: "Bearer " + session } : {},
        ),
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      let data = null;
      try {
        data = await res.json();
      } catch (e) {
        data = null;
      }
      if (res.status === 401) {
        logout();
        throw new Error("登录已过期，请重新输入密码");
      }
      if (!res.ok) throw new Error((data && data.error) || res.status + " " + res.statusText);
      return data;
    }

    async function listFiles() {
      const dir = DIRS[tab];
      const data = await api("/api/files?dir=" + (tab === "posts" ? "posts" : "projects") + "&_=" + Date.now());
      const list = $("list");
      list.innerHTML = "";
      const files = (data && data.files) || [];
      if (!files.length) {
        list.innerHTML = '<div class="text-sm text-neutral-500 py-6 text-center">还没有内容，点「+ 新建」</div>';
        return;
      }
      files
        .sort((a, b) => a.name.localeCompare(b.name))
        .forEach((f) => {
          const row = document.createElement("div");
          row.className = "flex items-center gap-3 rounded-xl border border-(--line-divider) px-3 py-2 text-sm";
          row.innerHTML =
            '<span class="grow truncate">' + f.name + "</span>" +
            '<button class="edit px-3 py-1 rounded-lg border border-(--line-divider)">编辑</button>' +
            '<button class="del px-3 py-1 rounded-lg border border-red-300 text-red-500">删除</button>';
          row.querySelector(".edit").onclick = () => openEditor(f).catch((e) => alert(e.message));
          row.querySelector(".del").onclick = () => removeFile(f);
          list.appendChild(row);
        });
    }

    function parseFrontmatter(text) {
      const m = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
      if (!m) return { data: {}, body: text };
      const data = {};
      m[1].split(/\r?\n/).forEach((line) => {
        const kv = line.match(/^(\w+):\s*(.*)$/);
        if (kv) data[kv[1]] = kv[2].trim();
      });
      return { data, body: m[2] };
    }

    async function openEditor(file) {
      editing = file ? { name: file.name, path: file.path } : null;
      $("editor").classList.remove("hidden");
      $("editorTitle").textContent = file ? "编辑：" + file.name : "新建" + (tab === "posts" ? "文章" : "项目");
      $("editorMsg").textContent = "";
      $("catWrap").classList.toggle("hidden", tab !== "posts");
      $("statusWrap").classList.toggle("hidden", tab !== "projects");
      $("linkWrap").classList.toggle("hidden", tab !== "projects");
      $("fName").disabled = !!file;

      if (file) {
        $("editorMsg").textContent = "读取中…";
        const data = await api("/api/file?path=" + encodeURIComponent(file.path) + "&_=" + Date.now());
        $("editorMsg").textContent = "";
        const parsed = parseFrontmatter(data.content || "");
        const fm = parsed.data;
        $("fName").value = file.name.replace(/\.md$/, "");
        $("fTitle").value = (fm.title || "").replace(/^["']|["']$/g, "");
        $("fDate").value = (fm.published || "").slice(0, 10);
        $("fDesc").value = (fm.description || "").replace(/^["']|["']$/g, "");
        $("fTags").value = (fm.tags || "").replace(/[\[\]]/g, "");
        $("fCat").value = (fm.category || "").replace(/^["']|["']$/g, "");
        $("fStatus").value = (fm.status || "published").replace(/^["']|["']$/g, "");
        $("fLink").value = "";
        $("fBody").value = parsed.body;
      } else {
        $("fName").value = "";
        $("fTitle").value = "";
        $("fDate").value = new Date().toISOString().slice(0, 10);
        $("fDesc").value = "";
        $("fTags").value = tab === "posts" ? "随笔" : "项目";
        $("fCat").value = "随笔";
        $("fStatus").value = "published";
        $("fBody").value = "正文写在这里。\n";
        $("fLink").value = "";
      }
      $("editor").scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function buildMarkdown() {
      const yamlEscape = (s) => s.replace(/\r?\n/g, " ").trim();
      const tags = $("fTags").value
        .split(/[,，]/)
        .map((t) => t.trim())
        .filter(Boolean);
      const lines = ["---"];
      lines.push("title: " + yamlEscape($("fTitle").value));
      lines.push("published: " + ($("fDate").value || new Date().toISOString().slice(0, 10)));
      if ($("fDesc").value.trim()) lines.push("description: " + yamlEscape($("fDesc").value));
      lines.push("tags: [" + tags.join(", ") + "]");
      if (tab === "posts") {
        if ($("fCat").value.trim()) lines.push("category: " + yamlEscape($("fCat").value));
      } else {
        lines.push("status: " + $("fStatus").value);
        const linkVal = $("fLink").value.trim();
        if (linkVal) {
          const idx = linkVal.indexOf("|");
          const label = idx > -1 ? linkVal.slice(0, idx) : "链接";
          const url = idx > -1 ? linkVal.slice(idx + 1) : linkVal;
          lines.push("link:");
          lines.push("  - label: " + label.trim());
          lines.push("    value: " + url.trim());
        }
      }
      lines.push("---");
      lines.push("");
      return lines.join("\n") + $("fBody").value;
    }

    async function save() {
      const name = $("fName").value.trim().replace(/\.md$/, "");
      if (!name) return alert("请填写文件名");
      if (!$("fTitle").value.trim()) return alert("请填写标题");
      if (!/^[a-zA-Z0-9._-]+$/.test(name)) return alert("文件名只能用英文、数字、点、下划线、短横线");
      const path = editing ? editing.path : DIRS[tab] + "/" + name + ".md";
      $("editorMsg").textContent = "保存中…";
      try {
        await api("/api/file", {
          method: "PUT",
          body: {
            path: path,
            content: buildMarkdown(),
            message: (editing ? "更新 " : "新增 ") + (tab === "posts" ? "文章：" : "项目：") + name,
          },
        });
        $("editorMsg").textContent = "已保存，1~2 分钟后自动发布 ✓";
        editing = null;
        $("editor").classList.add("hidden");
        await listFiles();
      } catch (e) {
        $("editorMsg").textContent = "保存失败：" + e.message;
      }
    }

    async function removeFile(file) {
      if (!confirm("确定删除 " + file.name + " ？")) return;
      try {
        await api("/api/file", { method: "DELETE", body: { path: file.path, sha: file.sha } });
        await listFiles();
      } catch (e) {
        alert("删除失败：" + e.message);
      }
    }

    function paintTabs() {
      document.querySelectorAll(".tab-btn").forEach((b) => {
        const active = b.dataset.tab === tab;
        b.classList.toggle("bg-(--primary)", active);
        b.classList.toggle("text-white", active);
        b.classList.toggle("border", !active);
        b.classList.toggle("border-(--line-divider)", !active);
      });
    }

    async function enterPanel() {
      $("setup").classList.add("hidden");
      $("panel").classList.remove("hidden");
      paintTabs();
      $("list").innerHTML = '<div class="text-sm text-neutral-500 py-6 text-center">加载中…</div>';
      try {
        await listFiles();
      } catch (e) {
        $("list").innerHTML = '<div class="text-sm text-red-500 py-6 text-center">读取失败：' + e.message + "</div>";
      }
    }

    function logout() {
      session = "";
      localStorage.removeItem("admin_session");
      $("panel").classList.add("hidden");
      $("editor").classList.add("hidden");
      $("setup").classList.remove("hidden");
    }

    $("loginBtn").onclick = async () => {
      const pwd = $("pwdInput").value;
      if (!pwd) return;
      $("setupMsg").textContent = "登录中…";
      try {
        const data = await api("/api/login", { method: "POST", body: { password: pwd } });
        session = data.token;
        localStorage.setItem("admin_session", session);
        $("setupMsg").textContent = "";
        $("pwdInput").value = "";
        await enterPanel();
      } catch (e) {
        $("setupMsg").textContent = "登录失败：" + e.message;
      }
    };

    $("backendInput").value = localStorage.getItem("admin_backend") || "";
    $("backendSave").onclick = () => {
      const v = $("backendInput").value.trim();
      if (v) localStorage.setItem("admin_backend", v);
      else localStorage.removeItem("admin_backend");
      $("setupMsg").textContent = "后台地址已保存：" + backend();
    };

    document.querySelectorAll(".tab-btn").forEach((b) => {
      b.onclick = () => {
        tab = b.dataset.tab;
        $("editor").classList.add("hidden");
        paintTabs();
        listFiles().catch((e) => alert(e.message));
      };
    });
    $("newBtn").onclick = () => openEditor(null).catch((e) => alert(e.message));
    $("saveBtn").onclick = save;
    $("cancelBtn").onclick = () => $("editor").classList.add("hidden");
    $("logoutBtn").onclick = logout;
    $("pwdInput").addEventListener("keydown", (e) => {
      if (e.key === "Enter") $("loginBtn").click();
    });

    if (session) {
      api("/api/me")
        .then((d) => {
          if (d && d.ok) enterPanel();
          else logout();
        })
        .catch(() => logout());
    }
  </script>
</MainGridLayout>
